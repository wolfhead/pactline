PACTLINE_VERSION=sha-0123456789abcdef
PACTLINE_APP_BASE_URL=https://tasks.example.com
PACTLINE_BIND_ADDRESS=127.0.0.1
PACTLINE_HTTP_PORT=18080
PACTLINE_LOG_LEVEL=info
PACTLINE_SECRETS_DIR=./deploy/secrets

POSTGRES_USER=pactline
POSTGRES_DB=pactline
RABBITMQ_USER=pactline

# local, oss, or cos. Local storage uses the durable Compose volume.
ATTACHMENT_STORAGE_PROVIDER=local
# OSS: ATTACHMENT_OSS_REGION, ATTACHMENT_OSS_ENDPOINT (optional),
# ATTACHMENT_OSS_BUCKET, ATTACHMENT_OSS_ACCESS_KEY_ID
# COS: ATTACHMENT_COS_BUCKET_URL, ATTACHMENT_COS_SERVICE_URL (optional),
# ATTACHMENT_COS_SECRET_ID

LARK_APP_ID=replace-me
LARK_REDIRECT_URI=https://tasks.example.com/api/auth/lark/callback
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
OAUTH_TOKEN_ENCRYPTION_KEY_ID=primary

AGENT_ENABLED=false
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# Used only with deploy/compose.agent-vision.yaml.
AGENT_VISION_BASE_URL=https://api.jiekou.ai/openai
AGENT_VISION_MODEL=gemini-2.5-flash-lite
AGENT_DELEGATION_SIGNING_KEY_ID=agent-delegate-primary
AGENT_CHECKPOINT_ENCRYPTION_KEY_ID=agent-checkpoint-primary
AGENT_WORKER_CONCURRENCY=1
AGENT_TENANT_TIMEZONE=Asia/Shanghai
