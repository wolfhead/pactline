{
  "name": "@pactline/fleet",
  "version": "0.0.0-development",
  "description": "Harness-neutral orchestration for Pactline work",
  "private": true,
  "workspaces": [
    "web"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "pactline-fleet": "lib/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./harness-adapter": {
      "types": "./lib/core/harness-adapter.d.ts",
      "default": "./lib/core/harness-adapter.js"
    },
    "./adapters/deepseek": {
      "types": "./lib/adapters/deepseek/deepseek-adapter.d.ts",
      "default": "./lib/adapters/deepseek/deepseek-adapter.js"
    },
    "./adapters/codex": {
      "types": "./lib/adapters/codex/codex-adapter.d.ts",
      "default": "./lib/adapters/codex/codex-adapter.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "evaluation/baselines/*.json",
    "evaluation/cases/*.json",
    "evaluation/hidden/l2-v2/*.go",
    "evaluation/fixtures/deepseek-l1/**/*",
    "config.example.yml",
    "runtime/deepseek/package.json",
    "runtime/deepseek/package-lock.json",
    "runtime/deepseek/*.yml",
    "runtime/deepseek/*.mjs",
    "runtime/codex/package.json",
    "runtime/codex/package-lock.json",
    "web/dist/**/*",
    "README.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "baseline:verify": "node scripts/verify-deepseek-baseline.mjs",
    "build": "npm run build:service && npm run build:web",
    "build:service": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "doctor": "npm run build && node lib/bin.js doctor --json",
    "deepseek:install": "npm --prefix runtime/deepseek ci",
    "codex:install": "npm --prefix runtime/codex ci --ignore-scripts",
    "codex:doctor": "npm run build && node lib/bin.js codex-doctor --json",
    "codex:l1": "npm run build && node lib/evaluation/codex-l1-bin.js",
    "l2-v2:preflight": "npm run build && node lib/evaluation/l2-v2-preflight-bin.js",
    "l2-v2:provision": "npm run build && node lib/evaluation/l2-v2-provision-bin.js",
    "l2-v2:codex": "npm run build && node lib/evaluation/l2-v2-live-bin.js",
    "l2-v2:mixed": "npm run build && node lib/evaluation/l2-v2-mixed-bin.js",
    "l2-v2:report": "npm run build && node lib/evaluation/l2-v2-report-bin.js",
    "deepseek:l1": "npm run build && node lib/evaluation/deepseek-l1-bin.js",
    "deepseek:test": "npm --prefix runtime/deepseek ci && vitest run tests/adapters/deepseek-runtime.integration.test.ts",
    "codex:test": "npm --prefix runtime/codex ci --ignore-scripts && vitest run tests/adapters/codex-adapter.test.ts tests/adapters/codex-wire.test.ts",
    "local:integration": "npm run build && node lib/evaluation/local-integration-bin.js",
    "service:m5-1-smoke": "npm run build && node scripts/m5-1-smoke.mjs",
    "service:m5-3-package-smoke": "npm run build && node scripts/m5-3-package-smoke.mjs",
    "service:m5-2-deepseek-demo": "PACTLINE_FLEET_LIVE_DEEPSEEK=1 vitest run tests/service/m5-2-plugin-service.integration.test.ts",
    "test": "npm run test:service && npm run test:web",
    "test:e2e": "npm --prefix web run test:e2e",
    "test:service": "vitest run",
    "test:web": "npm --prefix web test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && npm --prefix web run typecheck"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "4.1.4",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
