APP_ENV=production
AUTH_PROVIDER=lark
APP_BASE_URL=https://tasks.example.com
# Base64-encoded 32 random bytes. Generate separately for each value.
SESSION_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=
OAUTH_TOKEN_ENCRYPTION_KEY_ID=primary
LARK_APP_ID=
LARK_APP_SECRET=
LARK_TENANT_KEY=
LARK_REDIRECT_URI=https://tasks.example.com/api/auth/lark/callback
BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# First-party Lark Agent. Keep disabled until the bot event subscription and
# required group-message permissions have been published.
AGENT_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
AGENT_DELEGATION_SIGNING_KEY=
AGENT_DELEGATION_SIGNING_KEY_ID=agent-delegate-primary
AGENT_CHECKPOINT_ENCRYPTION_KEY=
AGENT_CHECKPOINT_ENCRYPTION_KEY_ID=agent-checkpoint-primary
AGENT_WORKER_CONCURRENCY=1
AGENT_TENANT_TIMEZONE=Asia/Shanghai
